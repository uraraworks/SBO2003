IDR_MENU1 MENU DISCARDABLE 
BEGIN
    POPUP "ﾏｯﾌﾟ(&M)"
    BEGIN
        MENUITEM "新規ﾏｯﾌﾟ追加(&N)",            IDM_MAP_ADD
        MENUITEM "ﾊﾟｰﾂ(&P)",                    IDM_MAP_PARTS
        MENUITEM "ﾏｯﾌﾟ情報(&I)",                IDM_MAP_INFO
        MENUITEM "ｲﾍﾞﾝﾄ情報(&E)",               IDM_MAP_EVENT
        MENUITEM "ﾒｯｾｰｼﾞ(&M)",                  IDM_MAP_MSG
        MENUITEM "店情報(&S)",                  IDM_MAP_SHOP
    END
    POPUP "ｷｬﾗ(&C)"
    BEGIN
        MENUITEM "ｷｬﾗ情報(&C)",                 IDM_CHAR_INFO
        MENUITEM "追加(&A)",                    IDM_CHAR_ADD
        MENUITEM "所持ｱｲﾃﾑ情報(&I)",            IDM_CHAR_ITEM
        MENUITEM "所持魔法情報(&M)",            IDM_CHAR_MAGIC
        MENUITEM "ｽﾃｰﾀｽ情報(&S)",               IDM_CHAR_STATUS
        MENUITEM "預かり所情報(&L)",            IDM_CHAR_LEAVE
        MENUITEM "ｽﾃｰﾀｽﾃﾝﾌﾟﾚｰﾄ情報(&T)",        IDM_CHAR_STTMP
        MENUITEM "NPCの巡回(&R)",               IDM_CHAR_NPCROUTE
    END
    POPUP "ｱｲﾃﾑ(&I)"
    BEGIN
        MENUITEM "一覧(&L)",                    IDM_ITEM_LIST
    END
    POPUP "ｱｶｳﾝﾄ(&A)"
    BEGIN
        MENUITEM "編集(&E)",                    IDM_ACC_INFO
        MENUITEM "追加(&A)",                    IDM_ACC_ADD
        MENUITEM "検索(&S)",                    IDM_ACC_SEARCH
    END
    POPUP "ｴﾌｪｸﾄ(&E)"
    BEGIN
        MENUITEM "ふきだし(&C)",                IDM_CEF_EDIT
        MENUITEM "効果いろいろ(&E)",            IDM_EFC_EDIT
    END
    POPUP "その他(&E)"
    BEGIN
        MENUITEM "各種通知(&S)",                IDM_ETC_VERSION
        MENUITEM "ｻｰﾊﾞｰ情報(&I)",               IDM_ETC_SVRINFO
        MENUITEM "ｻﾌﾞｹﾞｰﾑ情報(&G)",             IDM_ETC_SUBGAME
        MENUITEM "職業情報(&J)",                IDM_ETC_JOBINFO
        MENUITEM "魔法情報(&M)",                IDM_ETC_MAGICINFO
        MENUITEM "魔法利用者情報(&U)",          IDM_ETC_MAGICUSERINFO
        MENUITEM "装備職業情報(&E)",            IDM_ETC_EQUUSERINFO
        MENUITEM "ギルドの依頼(&Q)",            IDM_ETC_QUEST
    END
    POPUP "編集(&Z)"
    BEGIN
        MENUITEM "この画面の変更を元に戻す(&U)", IDM_ADMIN_UNDO
    END
END


