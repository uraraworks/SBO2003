IDD_MAP_LIGHT DIALOGEX 0, 0, 250, 294
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "明るさ・灯り・見え方の設定"
FONT 9, "ＭＳ Ｐゴシック", 0, 0, 0x1
BEGIN
    GROUPBOX        "明るさの範囲",IDC_STATIC,4,2,242,112
    LTEXT           "",IDC_ML_AREAINFO,9,12,180,8
    LISTBOX         IDC_ML_AREALIST,9,22,180,48,LBS_NOTIFY | WS_VSCROLL | 
                    WS_TABSTOP
    PUSHBUTTON      "追加",IDC_ML_AREAADD,194,22,46,13
    PUSHBUTTON      "削除",IDC_ML_AREADEL,194,37,46,13
    PUSHBUTTON      "上へ",IDC_ML_AREAUP,194,52,22,13
    PUSHBUTTON      "下へ",IDC_ML_AREADOWN,218,52,22,13
    LTEXT           "種類：",IDC_STATIC,9,77,22,8
    COMBOBOX        IDC_ML_AREATYPE,31,75,72,60,CBS_DROPDOWNLIST | 
                    WS_VSCROLL | WS_TABSTOP
    LTEXT           "左上",IDC_STATIC,108,77,16,8
    EDITTEXT        IDC_ML_AREAX1,125,75,22,12,ES_AUTOHSCROLL | ES_NUMBER
    EDITTEXT        IDC_ML_AREAY1,149,75,22,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "右下",IDC_STATIC,175,77,16,8
    EDITTEXT        IDC_ML_AREAX2,192,75,22,12,ES_AUTOHSCROLL | ES_NUMBER
    EDITTEXT        IDC_ML_AREAY2,216,75,22,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "暗くする範囲が1つでもあれば、どの範囲にも入らない所は明るい。",
                    IDC_STATIC,9,92,232,8
    LTEXT           "重なった所は下の範囲が優先。壁で隠す＝壁の向こうは見えない。",
                    IDC_STATIC,9,102,232,8
    GROUPBOX        "光源（天井の灯りなど）",IDC_STATIC,4,117,242,96
    LTEXT           "",IDC_ML_LIGHTINFO,9,127,180,8
    LISTBOX         IDC_ML_LIGHTLIST,9,137,180,44,LBS_NOTIFY | WS_VSCROLL | 
                    WS_TABSTOP
    PUSHBUTTON      "追加",IDC_ML_LIGHTADD,194,137,46,13
    PUSHBUTTON      "削除",IDC_ML_LIGHTDEL,194,152,46,13
    LTEXT           "位置",IDC_STATIC,9,188,16,8
    EDITTEXT        IDC_ML_LIGHTX,26,186,22,12,ES_AUTOHSCROLL | ES_NUMBER
    EDITTEXT        IDC_ML_LIGHTY,50,186,22,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "範囲",IDC_STATIC,78,188,16,8
    EDITTEXT        IDC_ML_LIGHTRANGE,95,186,16,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "マス(1-7)",IDC_STATIC,113,188,32,8
    LTEXT           "強さ",IDC_STATIC,148,188,16,8
    EDITTEXT        IDC_ML_LIGHTPOWER,165,186,20,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "%(1-100)",IDC_STATIC,187,188,36,8
    CONTROL         "ゆらめかない",IDC_ML_NOFLICKER,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,9,201,60,10
    CONTROL         "暖色（炎のような橙色）",IDC_ML_WARM,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,74,201,100,10
    GROUPBOX        "見え方",IDC_STATIC,4,216,242,46
    LTEXT           "見える範囲：",IDC_STATIC,9,228,44,8
    EDITTEXT        IDC_ML_VIEWRANGE,55,226,20,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "マス（0=制限なし。1〜10）",IDC_STATIC,78,228,160,8
    LTEXT           "見えない所：",IDC_STATIC,9,245,44,8
    EDITTEXT        IDC_ML_HIDEPARTS,55,243,26,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "パーツ番号（0=黒。草原などで森のよう）",IDC_STATIC,
                    84,245,156,8
    LTEXT           "",IDC_ML_CLICK,6,266,240,8
    DEFPUSHBUTTON   "OK",IDOK,138,277,50,14
    PUSHBUTTON      "キャンセル",IDCANCEL,194,277,50,14
END


