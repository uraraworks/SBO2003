        MENUITEM "ｲﾍﾞﾝﾄ情報(&E)",               IDM_MAP_EVENT
        MENUITEM "ﾒｯｾｰｼﾞ(&M)",                  IDM_MAP_MSG
        MENUITEM "店情報(&S)",                  IDM_MAP_SHOP
    END
    POPUP "ｷｬﾗ(&C)"
    BEGIN
        MENUITEM "ｷｬﾗ情報(&C)",                 IDM_CHAR_INFO
        MENUITEM "追加(&A)",                    IDM_CHAR_ADD
        MENUITEM "所持ｱｲﾃﾑ情報(&I)",            IDM_CHAR_ITEM
        MENUITEM "所持魔法情報(&M)",            IDM_CHAR_MAGIC
        MENUITEM "ｽﾃｰﾀｽ情報(&S)",               IDM_CHAR_STATUS
