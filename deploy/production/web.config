<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sbo2003 用 IIS サイトの設定（C:\SBO2003\iis をサイトの物理パスにする）。
  http で来たリクエストは https へリダイレクトし、それ以外はすべて 127.0.0.1:18090 の Sbo2003 サーバーへ渡す（ブラウザ版の配布も WebSocket の /ws も）。
  必要なもの: URL Rewrite、Application Request Routing（プロキシを有効にしておく）、WebSocket プロトコル（IIS の機能）。
  SBOP2 のサイトですでに使っているものと同じ。ポートを変えた時は sbo2003.env の SBO2003_HTTP_PORT と合わせる。
  サーバーはパスがルート（/）にある前提なので、サブアプリではなく専用のサイト（専用のホスト名）にする。
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- http で来た時は https へ（301）。証明書は VPS 側で取得済みの前提 -->
        <rule name="Sbo2003HttpsRedirect" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Sbo2003Proxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:18090/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
