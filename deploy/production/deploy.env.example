# deploy.local.env という名前でコピーして値を埋める（deploy.local.env は .gitignore 済み。コミットしない）。
# Mac から vps-deploy.sh・move-staging-data.sh を動かす時に読み込む。

# 本番 VPS（Windows Server + OpenSSH。MangaViewer と同じ鍵・ユーザーでよい）
VPS_HOST=
VPS_PORT=22
VPS_USER=
SSH_KEY=~/.ssh/urara_vps_deploy
# VPS_ROOT=C:/SBO2003
HEALTH_URL=https://sbo2003.urara-works.jp/health

# ステージング（データを持っていく時だけ使う）
STAGING_TARGET=
# STAGING_SSH_KEY=~/.ssh/id_rsa
