# Sbo2003 ステージングの設定。staging.env にコピーして値を埋める（staging.env はコミットしない）。

# ステージングのドメイン（DNS の A レコードを SBOP2 のステージングと同じホストに向けておく）。
# Let's Encrypt の証明書は SBOP2 の Caddy が自動で取る。
# sslip.io を使うなら、SBOP2 のドメインの頭に名前を付ける（例: sbo2003.203-0-113-10.sslip.io）。DNS の作業は要らない。
SBO2003_STAGING_DOMAIN=sbo2003-staging.example.com

# Basic 認証のユーザー名と、パスワードのハッシュ。ハッシュは次で作る:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'パスワード'
SBO2003_BASIC_USER=sbo2003
SBO2003_BASIC_HASH=

# ゲームの管理者アカウント（SboSvr.ini の [Administrator]）のパスワード。
# 空のままだと元データの設定のまま（パスワード無し）になるので、必ず決めておく。
SBO2003_ADMIN_PASSWORD=
