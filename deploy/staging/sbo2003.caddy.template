# Sbo2003 ステージングのサイト定義（SBOP2 のステージングの Caddy が import する）。
# deploy.sh が staging.env の値を埋めて ~/caddy-sites/sbo2003.caddy に置く。直接書き換えないこと。
@@DOMAIN@@ {
	# ゲームの WebSocket。iPhone の Safari は WebSocket に Basic 認証の資格情報を
	# 付けないため、ここだけ Basic 認証の外に置く（ゲーム自体のログインで守られる）。
	@ws path /ws
	handle @ws {
		reverse_proxy sbo2003-staging:8080
	}

	# AI 用のデータ API と MCP の入口。AI のツールは Authorization ヘッダーに AI 用キーを
	# 入れて来るので Basic 認証とぶつかる。ここも Basic 認証の外に置く（AI 用キーで守られる）。
	@ai path /mcp /api/data/*
	handle @ai {
		reverse_proxy sbo2003-staging:8080
	}

	handle {
		basic_auth {
			@@BASIC_USER@@ @@BASIC_HASH@@
		}
		# サーバーは圧縮しないのでここで圧縮する。ブラウザ版の .data（application/octet-stream）は
		# Caddy の既定では圧縮されないので、対象に含める（9.4MB → 約 6.4MB）
		encode {
			zstd
			gzip
			match {
				header Content-Type text/*
				header Content-Type application/*
			}
		}
		reverse_proxy sbo2003-staging:8080
	}

	log {
		output stdout
		format console
	}
}
